# Salin file ini menjadi ".env" untuk uji lokal dengan "netlify dev".
# Di Netlify, isi nilai-nilai ini lewat Site configuration > Environment variables.
# JANGAN pernah meng-commit file .env ke GitHub.

APP_PASSWORD=ganti-dengan-kata-sandi-panjang
LLM_PROVIDER=anthropic        # anthropic atau openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=               # wajib untuk fitur Suara ke berita

# Opsional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5
# TRANSCRIBE_MODEL=gpt-4o-transcribe
# IMAGE_MODEL=gemini-3.1-flash-image   # menu Gambar ilustrasi (lewat AI Gateway Netlify)
# MAX_INPUT_CHARS=120000
# LLM_TIMEOUT_MS=25000
